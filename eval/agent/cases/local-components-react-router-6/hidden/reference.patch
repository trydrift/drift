index 0000000..8a87f8d
--- /dev/null
+++ b/src/common/helpers/withRouter.tsx
@@ -0,0 +1,40 @@
+import * as React from 'react';
+import { useLocation, useNavigate, useParams, useResolvedPath } from 'react-router-dom';
+
+/**
+ * The router props a class component used to get from react-router-dom 5.
+ *
+ * v6 removed `withRouter` and exposes the same information through hooks, which
+ * class components cannot call. This is the shim the v6 migration guide
+ * describes: a function wrapper that reads the hooks and passes them down, so
+ * the class components keep their shape and only their plumbing moves.
+ *
+ * `match.url` is the resolved path of the route the component is rendered
+ * under, which is what `useResolvedPath('')` returns.
+ */
+export interface RouteComponentProps {
+	location: ReturnType<typeof useLocation>;
+	navigate: ReturnType<typeof useNavigate>;
+	params: ReturnType<typeof useParams>;
+	match: { url: string; params: ReturnType<typeof useParams> };
+}
+
+export function withRouter<P extends RouteComponentProps>(
+	Component: React.ComponentType<P>
+): React.FC<Omit<P, keyof RouteComponentProps>> {
+	return function WithRouter(props) {
+		const location = useLocation();
+		const navigate = useNavigate();
+		const params = useParams();
+		const resolved = useResolvedPath('');
+		return (
+			<Component
+				{...(props as P)}
+				location={location}
+				navigate={navigate}
+				params={params}
+				match={{ url: resolved.pathname, params }}
+			/>
+		);
+	};
+}
