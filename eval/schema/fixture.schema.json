{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drift.local/eval/fixture.schema.json",
  "description": "Documentation mirror of the Zod schema in eval/src/load.ts, which is authoritative at runtime. Keep in sync by hand.",
  "type": "object",
  "required": [
    "id",
    "ecosystem",
    "dependency",
    "fromVersion",
    "toVersion",
    "scenarioLabel",
    "source",
    "exposure",
    "oracles",
    "complexity",
    "network",
    "readiness",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "ecosystem": { "type": "string" },
    "dependency": { "type": "string" },
    "fromVersion": { "type": "string" },
    "toVersion": { "type": "string" },
    "scenarioLabel": {
      "type": "string",
      "description": "Informational/reporting only. Never read by the detect-end-to-end adapter."
    },
    "source": {
      "type": "object",
      "required": ["repository", "licence"],
      "properties": {
        "repository": { "type": "string" },
        "licence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "exposure": { "enum": ["direct", "transitive"] },
    "oracles": {
      "type": "object",
      "required": ["baseline", "broken", "repaired"],
      "properties": {
        "baseline": { "$ref": "#/$defs/oracleStage" },
        "broken": { "$ref": "#/$defs/oracleStage" },
        "repaired": { "$ref": "#/$defs/oracleStage" }
      },
      "additionalProperties": false
    },
    "complexity": { "enum": ["small", "medium", "large"] },
    "network": { "enum": ["disabled", "fixture-local", "allowed"] },
    "readiness": {
      "enum": ["draft", "benchmark-ready"],
      "description": "Workflow marker only. eval:review:validate is what actually gates benchmark-ready status."
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "createdAt", "author"],
      "properties": {
        "kind": { "enum": ["synthetic", "historical"] },
        "createdAt": { "type": "string" },
        "author": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "oracleStage": {
      "type": "object",
      "required": ["command", "expect"],
      "properties": {
        "command": { "type": "string" },
        "expect": { "enum": ["pass", "fail"] }
      },
      "additionalProperties": false
    }
  }
}
