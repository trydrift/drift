# Only production bundles, the manifest, media, README and LICENSE ship.
src/**
test/**
node_modules/**
tsconfig.json
esbuild.mjs
.vscode/**
.git/**
.gitignore

# Test and preview artifacts that land in dist/ alongside the real bundle.
dist/harness.cjs
dist/*.test.cjs
dist/report-preview.html
dist/report-themed.html
dist/report.png
**/*.map
**/*.vsix
