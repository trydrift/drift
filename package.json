{
  "name": "@usedrift/cli",
  "version": "0.1.0",
  "description": "Drift detects dependency API changes, proves which ones break your code, and fixes them deterministically, via a community recipe, or with an AI agent, in a reviewable, atomically-committed pull request.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/trydrift/drift.git"
  },
  "homepage": "https://github.com/trydrift/drift#readme",
  "bugs": {
    "url": "https://github.com/trydrift/drift/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "drift": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "action",
    "action.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-strip-types \"test/*.test.ts\"",
    "serve": "node dist/runners/webhook.js",
    "prepublishOnly": "npm run build",
    "build:action": "esbuild src/runners/action-entry.ts --bundle --platform=node --target=node20 --format=cjs --minify --outfile=action/index.cjs",
    "build:all": "npm run build && npm run build:action",
    "docs:support": "npm run build && node scripts/generate-support-doc.mjs",
    "eval:deterministic": "npm run build && node --experimental-strip-types eval/src/run.ts --ci",
    "verify:action-bundle": "node scripts/verify-action-bundle.mjs",
    "smoke:packed-cli": "node scripts/smoke-test-packed-cli.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "semver": "^7.6.3",
    "typescript": "^7.0.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/semver": "^7.5.8",
    "esbuild": "^0.28.1"
  },
  "keywords": [
    "dependencies",
    "breaking-changes",
    "github-copilot",
    "automated-refactoring",
    "openapi"
  ],
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.68.0"
  }
}
