{
  "name": "@usedrift/cli",
  "version": "0.1.0",
  "description": "Find which dependency upgrades affect your code, show the evidence, and prepare reviewable fixes from the command line.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/trydrift/drift.git"
  },
  "homepage": "https://github.com/trydrift/drift#readme",
  "bugs": {
    "url": "https://github.com/trydrift/drift/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "drift": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "action",
    "action.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-strip-types \"test/*.test.ts\"",
    "serve": "node dist/runners/webhook.js",
    "prepublishOnly": "npm run build",
    "build:action": "node scripts/build-action.mjs",
    "build:all": "npm run build && npm run build:action",
    "docs:support": "npm run build && node scripts/generate-support-doc.mjs",
    "eval:deterministic": "npm run build && node --experimental-strip-types eval/src/run.ts --ci",
    "verify:action-bundle": "node scripts/verify-action-bundle.mjs",
    "smoke:packed-cli": "node scripts/smoke-test-packed-cli.mjs",
    "release:check": "node scripts/release-check.mjs",
    "build:workflow": "npm run build && node scripts/build-workflow.mjs",
    "verify:workflow": "npm run build && node scripts/build-workflow.mjs --check",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "semver": "^7.6.3",
    "typescript": "^7.0.2",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/semver": "^7.5.8",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0"
  },
  "keywords": [
    "dependencies",
    "dependency-updates",
    "dependency-upgrades",
    "breaking-changes",
    "dependabot",
    "renovate",
    "codemod",
    "github-actions",
    "github-copilot",
    "ai-agents",
    "developer-tools"
  ],
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.68.0"
  }
}
