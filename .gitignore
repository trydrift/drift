node_modules/
dist/
# action/ is intentionally NOT ignored: GitHub Actions does not run npm
# install for node20 actions, so the bundled entrypoint must be committed.
*.log
.env
.env.*
!.env.example
.DS_Store
coverage/
.drift-cache/
settings.json

# Build output for the landing page (site/).
#
# Listed at the repository root, not only in `site/.gitignore`, because a
# per-directory ignore file is itself tracked — checking out a branch that
# predates it deletes the ignore rules while leaving the untracked build
# output on disk, and the next `git add -A` on that branch commits 134MB of
# Turbopack cache. Which is exactly what happened once.
site/.next/
site/out/
site/next-env.d.ts
*.tsbuildinfo

# Benchmark output — profiles and per-run summaries, regenerated on demand.
bench-results/
drift-profile.json

# A second build, kept only while A/B-ing two engine commits.
.oldbuild/

# Third-party benchmark corpora, cloned or downloaded on demand.
#
# These are other people's datasets — Git repositories, Zenodo replication
# kits, Docker image metadata, and the package caches an actual reproduction
# leaves behind. Committing them would add hundreds of megabytes this
# repository has no right to redistribute, and the adapters that read them
# already record the exact DOI, commit or image digest they were fetched at,
# so the pinning that makes a run reproducible lives in the artifact rather
# than in a vendored copy.
#
# Everything under `eval/external/` — the adapters, the label mappings, the
# deterministic selection manifests, the small frozen truth extracts — IS
# tracked, and is what makes a run repeatable from a clean checkout.
benchmarks/*
!benchmarks/README.md
!benchmarks/fetch.sh

# Per-case checkpoints an external run writes as it goes.
#
# They exist so an interrupted run is still re-scorable, and a *completed* run
# supersedes its own with `cases.jsonl.gz`. Committing both would publish the
# same observations twice, uncompressed.
eval/results/*/cases.partial.jsonl

# Raw upstream evidence an external run fetches into its own results dir
# (eval/src/external/cli.ts's evidenceRoot). Per-run, large, and reproducible
# from the pinned source the run's manifest records — not worth redistributing.
eval/results/*/evidence/

*.cpuprofile.txt