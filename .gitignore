node_modules/
dist/
# action/ is intentionally NOT ignored: GitHub Actions does not run npm
# install for node20 actions, so the bundled entrypoint must be committed.
*.log
.env
.env.*
!.env.example
.DS_Store
coverage/
.drift-cache/
settings.json

# Build output for the landing page (site/).
#
# Listed at the repository root, not only in `site/.gitignore`, because a
# per-directory ignore file is itself tracked — checking out a branch that
# predates it deletes the ignore rules while leaving the untracked build
# output on disk, and the next `git add -A` on that branch commits 134MB of
# Turbopack cache. Which is exactly what happened once.
site/.next/
site/out/
site/next-env.d.ts
*.tsbuildinfo

# Benchmark output — profiles and per-run summaries, regenerated on demand.
bench-results/
drift-profile.json

# A second build, kept only while A/B-ing two engine commits.
.oldbuild/
